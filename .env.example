# Server-only Sectors API configuration. Never commit real credentials and
# never expose SECTORS_API_KEY to the browser.
SECTORS_API_BASE_URL=https://api.sectors.app/v2/
SECTORS_API_KEY=dummy_key_dry_run_hackathon_2026

# Set to "true" to run the AKRA workflow from local payload fixtures
# (development and tests only). Leave unset or "false" for live Sectors data.
USE_FIXTURES=true

# Optional: custom raw-response evidence cache directory.
# Defaults to packages/evidence-store/.cache
# AETHERIA_EVIDENCE_CACHE_DIR=

# Optional: Google AI Studio (Gemini) key for the AI Copilot. When omitted or
# when the request fails, the copilot returns a deterministic offline fallback
# so the app still works during local tests and demos without internet.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the Gemini model (defaults to gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.0-flash
# Optional: request timeout in milliseconds for Gemini calls.
# GEMINI_TIMEOUT_MS=12000