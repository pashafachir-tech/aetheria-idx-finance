# Server-only Sectors API configuration. Never commit real credentials and
# never expose SECTORS_API_KEY to the browser.
SECTORS_API_BASE_URL=
SECTORS_API_KEY=

# Set to "true" to run the AKRA workflow from local payload fixtures
# (development and tests only). Leave unset or "false" for live Sectors data.
USE_FIXTURES=false

# Optional: custom raw-response evidence cache directory.
# Defaults to packages/evidence-store/.cache
# AETHERIA_EVIDENCE_CACHE_DIR=